{
  "name": "appointment-booking-system",
  "version": "1.0.0",
  "description": "Complete MERN Stack Appointment Booking System",
  "scripts": {
    "start": "node backend/server.js",
    "postinstall": "npm --prefix backend install --omit=dev",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start"
  },
  "keywords": ["mern", "appointment", "booking"],
  "author": "",
  "license": "ISC"
}
